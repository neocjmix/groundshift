RUN wget -q -O /tmp/safari-diagnostics.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-safari-diagnostics-2026-11-07/groundshift-safari-diagnostics-20261107.tar.gz \
 && echo 'bcb1f2c28f75f623fe488f5e23824e00dcfc6017f39e386d84d37b29eca818da  /tmp/safari-diagnostics.tar.gz' | sha256sum -c - \
 && mkdir /out \
 && tar -xzf /tmp/safari-diagnostics.tar.gz -C /out

# Provisional worker-path evidence; the following source patch validates separately.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS safari_worker_evidence
RUN wget -q -O /tmp/safari-worker-evidence.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-safari-worker-evidence-2026-11-07/groundshift-safari-worker-evidence-20261107.tar.gz \
 && echo '784aa1bdcccc215f46d30b46cc007ea9452b3527c6336dcf4beee64a19c02e6b  /tmp/safari-worker-evidence.tar.gz' | sha256sum -c - \
 && mkdir /out \
 && tar -xzf /tmp/safari-worker-evidence.tar.gz -C /out

# Version-pinned buffered decode workaround; physical-device cause remains unconfirmed.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS safari_worker_fix
RUN wget -q -O /tmp/safari-worker-fix.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-safari-worker-fix-2026-11-07/groundshift-safari-worker-fix-20261107.tar.gz \
 && echo '9861fcfc0d56b739751665026dd7c71ca011b13b0519ba1a5224ab6cfec1ff94  /tmp/safari-worker-fix.tar.gz' | sha256sum -c - \
 && mkdir /out \
 && tar -xzf /tmp/safari-worker-fix.tar.gz -C /out

# Final actual WebKit/Chrome evidence; two JSON files, same tested runtime assets.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS safari_worker_verified
RUN wget -q -O /tmp/safari-worker-verified.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-safari-worker-verified-2026-11-07/groundshift-safari-worker-verified-20261107.tar.gz \
 && echo '6c61e70512b742cc1481e7504b2f9dab0b8f4c9871e701c4b00483979fb999f0  /tmp/safari-worker-verified.tar.gz' | sha256sum -c - \
 && mkdir /out \
 && tar -xzf /tmp/safari-worker-verified.tar.gz -C /out

# User-reported Safari recovery and the bounded full-route campaign start.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS paris_route_started
RUN wget -q -O /tmp/paris-route-started.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-paris-route-started-2026-11-07/groundshift-paris-route-started-20261107.tar.gz \
 && echo 'ec17cc241396b8b9ba66a946df8763e5189d3948396a9f13c56f4bffb5cd4f54  /tmp/paris-route-started.tar.gz' | sha256sum -c - \
 && mkdir /out \
 && tar -xzf /tmp/paris-route-started.tar.gz -C /out

# Actual next-window acquisition/SfM/relative alignment; no new GS export yet.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS seine_alignment
RUN wget -q -O /tmp/seine-alignment.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-seine-alignment-1004-1027-2026-11-07/groundshift-seine-alignment-1004-1027-20261107.tar.gz \
 && echo '27d9025a187b24357ea749da7763528d2e48db19ca74036257e7a3c1f999d5e4  /tmp/seine-alignment.tar.gz' | sha256sum -c - \
 && mkdir /out \
 && tar -xzf /tmp/seine-alignment.tar.gz -C /out

# Optional bounded route viewer; actual multi-segment GPU boundary checks pending export.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS seine_route_viewer
RUN wget -q -O /tmp/seine-route-viewer.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-seine-route-viewer-2026-11-07/groundshift-seine-route-viewer-20261107.tar.gz \
 && echo '7906cf0aadbeb3925138ce1ccfdced31c882e440ae359c84baa5ec134607c731  /tmp/seine-route-viewer.tar.gz' | sha256sum -c - \
 && mkdir /out \
 && tar -xzf /tmp/seine-route-viewer.tar.gz -C /out

FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=historical /out/www /srv
COPY --from=tangent /out/www /srv
COPY --from=evidence /out/www /srv
COPY --from=limits /out/www /srv
COPY --from=verified /out/www /srv
COPY --from=gs_only /out/www /srv
COPY --from=gs_only_verified /out/www /srv
COPY --from=spz_export /out/www /srv
COPY --from=spz_measured /out/www /srv
COPY --from=spz_verified /out/www /srv
COPY --from=tourist_source /out/www /srv
COPY --from=tourist_acquired /out/www /srv
COPY --from=paris_sfm /out/www /srv
COPY --from=paris_depth /out/www /srv
COPY --from=paris_native /out/www /srv
COPY --from=paris_stream /out/www /srv
COPY --from=paris_subset_fail /out/www /srv
COPY --from=paris_lod /out/www /srv
COPY --from=paris_compact /out/www /srv
COPY --from=paris_verified /out/www /srv
COPY --from=fly_controls /out/www /srv
COPY --from=fly_capture_fix /out/www /srv
COPY --from=fly_ui_recovery /out/www /srv
COPY --from=fly_lifecycle_fix /out/www /srv
COPY --from=mobile_fly_ui /out/www /srv
COPY --from=lod_detail_refinement /out/www /srv
COPY --from=control_clearance /out/www /srv
COPY --from=lod_detail_evidence /out/www /srv
COPY --from=lod_detail_verified /out/www /srv
COPY --from=lod_report_verified /out/www /srv
COPY --from=safari_diagnostics /out/www /srv
COPY --from=safari_worker_evidence /out/www /srv
COPY --from=safari_worker_fix /out/www /srv
COPY --from=safari_worker_verified /out/www /srv
COPY --from=paris_route_started /out/www /srv
COPY --from=seine_alignment /out/www /srv
COPY --from=seine_route_viewer /out/www /srv
EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
