# Historical34-scene surface remains pinned; tangent-native is a separate additive layer.
# The release archive is separate from Git history and contains only www/.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS historical
RUN wget -q -O /tmp/viewer.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-model-selection-2026-11-06/groundshift-model-selection-20261106-v2.tar.gz \
    && echo 'cf8f223f78d4438de3f3d8cb1223269dbec983ac83066dd97263128e3a56b13d  /tmp/viewer.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/viewer.tar.gz -C /out

# Fresh public-only overlay; immutable base above remains a cached rollback.
RUN wget -q -O /tmp/overlay.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-final-quality-export-2026-11-06/groundshift-final-quality-export-20261106.tar.gz \
    && echo 'a278ecd09b7c1bddf74195161e2a75d1afa1757bb6626e0e59b9b981a9440c9c  /tmp/overlay.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/overlay.tar.gz -C /out

# Measured evidence overlays the cached native export without republishing its PLY.
RUN wget -q -O /tmp/evidence.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-final-quality-evidence-2026-11-06/groundshift-final-quality-evidence-20261106.tar.gz \
    && echo '070d3b51b9224bd0dd9fa0815ef4be82d6c2e5f5a8e2d03e6f56083142e52abd  /tmp/evidence.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/evidence.tar.gz -C /out

# Post-deployment checks: exactly two JSON observations; scene/evidence bytes unchanged.
RUN wget -q -O /tmp/verified.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-final-quality-verified-2026-11-06/groundshift-final-quality-verified-20261106.tar.gz \
    && echo 'e3a848b1d39e3fcff330358b102de40e1d1e1ecd64ad5d9b8927cdf64a047f48  /tmp/verified.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/verified.tar.gz -C /out

# New native output supersedes the early tangent plan/input/depth/viewer overlays.
# Keep this download in a separate stage and COPY layer: later small observations
# must not push a rebuilt1.2GB historical-world layer.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS tangent
RUN wget -q -O /tmp/tangent-native.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-tangent-native-2026-11-06/groundshift-tangent-native-20261106.tar.gz \
    && echo '8c09b353a96551ea5fa7eab357ebe67bc61961b0237858fbee5aa94e8ed306da  /tmp/tangent-native.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/tangent-native.tar.gz -C /out

# Measured outcome ships during local browser checks; actual GS appearance did not improve.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS evidence
RUN wget -q -O /tmp/tangent-evidence.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-tangent-evidence-2026-11-06/groundshift-tangent-evidence-20261106.tar.gz \
    && echo '55b2e885924bb007338a56b0e5c660df242bb2ee49e478006bc3163fccc0a15b  /tmp/tangent-evidence.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/tangent-evidence.tar.gz -C /out

FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=historical /out/www /srv
COPY --from=tangent /out/www /srv
COPY --from=evidence /out/www /srv
EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
