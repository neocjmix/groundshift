# Historical34-scene surface remains pinned; tangent-native is a separate additive layer.
# The release archive is separate from Git history and contains only www/.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS historical
RUN wget -q -O /tmp/viewer.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-model-selection-2026-11-06/groundshift-model-selection-20261106-v2.tar.gz \
    && echo 'cf8f223f78d4438de3f3d8cb1223269dbec983ac83066dd97263128e3a56b13d  /tmp/viewer.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/viewer.tar.gz -C /out

# Fresh public-only overlay; immutable base above remains a cached rollback.
RUN wget -q -O /tmp/overlay.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-final-quality-export-2026-11-06/groundshift-final-quality-export-20261106.tar.gz \
    && echo 'a278ecd09b7c1bddf74195161e2a75d1afa1757bb6626e0e59b9b981a9440c9c  /tmp/overlay.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/overlay.tar.gz -C /out

# Measured evidence overlays the cached native export without republishing its PLY.
RUN wget -q -O /tmp/evidence.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-final-quality-evidence-2026-11-06/groundshift-final-quality-evidence-20261106.tar.gz \
    && echo '070d3b51b9224bd0dd9fa0815ef4be82d6c2e5f5a8e2d03e6f56083142e52abd  /tmp/evidence.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/evidence.tar.gz -C /out

# Post-deployment checks: exactly two JSON observations; scene/evidence bytes unchanged.
RUN wget -q -O /tmp/verified.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-final-quality-verified-2026-11-06/groundshift-final-quality-verified-20261106.tar.gz \
    && echo 'e3a848b1d39e3fcff330358b102de40e1d1e1ecd64ad5d9b8927cdf64a047f48  /tmp/verified.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/verified.tar.gz -C /out

# New native output supersedes the early tangent plan/input/depth/viewer overlays.
# Keep this download in a separate stage and COPY layer: later small observations
# must not push a rebuilt1.2GB historical-world layer.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS tangent
RUN wget -q -O /tmp/tangent-native.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-tangent-native-2026-11-06/groundshift-tangent-native-20261106.tar.gz \
    && echo '8c09b353a96551ea5fa7eab357ebe67bc61961b0237858fbee5aa94e8ed306da  /tmp/tangent-native.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/tangent-native.tar.gz -C /out

# Measured outcome ships during local browser checks; actual GS appearance did not improve.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS evidence
RUN wget -q -O /tmp/tangent-evidence.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-tangent-evidence-2026-11-06/groundshift-tangent-evidence-20261106.tar.gz \
    && echo '55b2e885924bb007338a56b0e5c660df242bb2ee49e478006bc3163fccc0a15b  /tmp/tangent-evidence.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/tangent-evidence.tar.gz -C /out

# Actual background-limit evidence and report-only mobile wrap repair.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS limits
RUN wget -q -O /tmp/tangent-limits.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-tangent-limits-2026-11-06/groundshift-tangent-limits-20261106.tar.gz \
    && echo 'd08bfc7ffd29de440870a2c8fd4b001d4c09204ed8688559fb999c4e29f71463  /tmp/tangent-limits.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/tangent-limits.tar.gz -C /out

# Final verified status and results-first order: exactly two JSON files.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS verified
RUN wget -q -O /tmp/tangent-verified.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-tangent-verified-2026-11-06/groundshift-tangent-verified-20261106.tar.gz \
    && echo 'd8de6034d83f9fb3abdd1f0a99db148a1ea1d11a244c4a4bcaea329502cc4842  /tmp/tangent-verified.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/tangent-verified.tar.gz -C /out

# User rejects translated panorama/depth-shell completion: current display is GS only.
# The native PLY/poses and historical comparisons/rollback layers remain unchanged.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS gs_only
RUN wget -q -O /tmp/gs-only.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-gs-only-2026-11-07/groundshift-gs-only-20261107.tar.gz \
    && echo '41683c73ac684d7367bac8df1ac651e7534f26921122ff818dea6675db4a4697  /tmp/gs-only.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/gs-only.tar.gz -C /out

# Completed public4-case verification; exactly two observation JSON files.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS gs_only_verified
RUN wget -q -O /tmp/gs-only-verified.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-gs-only-verified-2026-11-07/groundshift-gs-only-verified-20261107.tar.gz \
    && echo 'd708a008e31932fd1d03a775c64ba7e0e95822b75ad9bbe900490facf8214ca8  /tmp/gs-only-verified.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/gs-only-verified.tar.gz -C /out

# First SPZ observation publishes before visual comparisons finish; originals remain available.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS spz_export
RUN wget -q -O /tmp/spz-export.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-spz-export-2026-11-07/groundshift-spz-export-20261107.tar.gz \
    && echo '744e31f5f78825b54ea69456d8f2561e4f023a4b348111f25274e677bf8e7b7d  /tmp/spz-export.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/spz-export.tar.gz -C /out

# Actual matched-render figures/motion publish while public verification continues.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS spz_measured
RUN wget -q -O /tmp/spz-measured.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-spz-measured-2026-11-07/groundshift-spz-measured-20261107.tar.gz \
    && echo '5750e201747c383f8237e791ff7b25be37e61c65fc41584eee13061f26edfcc5  /tmp/spz-measured.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/spz-measured.tar.gz -C /out

# Completed observations and sanitized evaluation cameras: exactly three JSON files.
FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS spz_verified
RUN wget -q -O /tmp/spz-verified.tar.gz https://github.com/neocjmix/groundshift/releases/download/viewer-spz-verified-2026-11-07/groundshift-spz-verified-20261107.tar.gz \
    && echo '7ec943885054826b1dc5e62722868ba85c4c73e8f915e7274eb886837b3c5600  /tmp/spz-verified.tar.gz' | sha256sum -c - \
    && mkdir /out \
    && tar -xzf /tmp/spz-verified.tar.gz -C /out

FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=historical /out/www /srv
COPY --from=tangent /out/www /srv
COPY --from=evidence /out/www /srv
COPY --from=limits /out/www /srv
COPY --from=verified /out/www /srv
COPY --from=gs_only /out/www /srv
COPY --from=gs_only_verified /out/www /srv
COPY --from=spz_export /out/www /srv
COPY --from=spz_measured /out/www /srv
COPY --from=spz_verified /out/www /srv
EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
